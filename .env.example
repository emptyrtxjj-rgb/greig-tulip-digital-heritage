APP_NAME="Greig Tulip Digital Chronicle"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database defaults to SQLite; no external database service is required.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

# Optional map tokens are not required: the map uses OpenStreetMap.
VITE_MAP_TILES=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
