# Optional. Defaults to the public OpenStreetMap tile endpoint; no key is required.
VITE_MAP_TILES=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional: local MP4/WebM path or a YouTube URL for the media-page field film.
# Example: VITE_FIELD_FILM_URL=/videos/flowering-season.mp4
VITE_FIELD_FILM_URL=

# Set the deployed public origin when generating canonical links and sitemap.
# Example: VITE_SITE_URL=https://museum.example
VITE_SITE_URL=
